# Demo/offline backend config

# MongoDB local
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=smartparking_local

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api/v1

# MQTT local Mosquitto
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_TOPIC_RFID=pbl5/smartparking/rfid_scanned
MQTT_TOPIC_GATE=pbl5/smartparking/gate
MQTT_TOPIC_GATE_ACK=pbl5/smartparking/gate_ack
MQTT_TOPIC_PARKING_STATUS=pbl5/smartparking/parking_status
BACKEND_MQTT_CLIENT_ID=SmartParkingBackendGate
MQTT_CLIENT_ID=CameraBridge

# ESP32-CAM. Replace this IP with the ESP32-CAM IP shown in Serial Monitor.
ESP32_CAM_URL=http://IP_ESP32_CAM/capture
ESP32_CAM_CONNECT_TIMEOUT=1.0
ESP32_CAM_READ_TIMEOUT=3.5
BURST_COUNT=2
BURST_INTERVAL_SEC=0.1
VEHICLE_CENTER_DELAY_SEC=0.2

# Camera bridge -> backend
BACKEND_ACCESS_EVENT_URL=http://127.0.0.1:8000/api/v1/access-events/rfid-camera
BACKEND_CONNECT_TIMEOUT=2.0
BACKEND_READ_TIMEOUT=30.0
CAMERA_BRIDGE_MODE=full
ACCESS_GATE_DIRECTION=auto
GATE_ID=1

# OCR/gate policy for PBL5 demo
OCR_ENTRY_POLICY=required
OCR_EXIT_POLICY=required
STRICT_OCR_BEFORE_GATE=true
ALLOW_ENTRY_ON_OCR_MISMATCH=false
ALLOW_EXIT_ON_OCR_FAILED=false
ALLOW_EXIT_ON_OCR_MISMATCH=false
ALLOW_EXIT_ON_OCR_FUZZY_MATCH=true
OCR_FUZZY_MAX_DISTANCE=2
OCR_TIMEOUT_SEC=3.5
OCR_MAX_IMAGES=2
CAMERA_BRIDGE_SLA_SEC=10
BACKEND_SLA_RESERVE_SEC=1.0
ADAPTIVE_THIRD_FRAME=false
ADAPTIVE_MAX_BURST_COUNT=2
UPLOAD_SELECTED_FRAMES_ONLY=true
OCR_FAST_VARIANTS=true
OCR_MAX_VARIANTS_PER_CROP=3
REGISTRATION_MODE_CHECK_TIMEOUT=0.6

# Optional: keep YOLO but run it only inside the fixed camera ROI.
PLATE_DETECTOR_CONF=0.20
PLATE_DETECTOR_IMGSZ=960
MAX_PLATE_DETECTIONS_PER_IMAGE=3
PLATE_CROP_PADDING_RATIO=0.20
PLATE_DETECTOR_FALLBACK_FULL_IMAGE=false
PLATE_DETECTOR_ROI_ENABLED=false
PLATE_DETECTOR_ROI_X1=0.18
PLATE_DETECTOR_ROI_Y1=0.12
PLATE_DETECTOR_ROI_X2=0.82
PLATE_DETECTOR_ROI_Y2=0.70
