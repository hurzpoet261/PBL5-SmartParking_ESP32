def is_capture_only_mode() -> bool:
    return CAMERA_BRIDGE_MODE == "capture_only"


NORMALIZED_PLATE_RE = re.compile(r"^\d{2}[A-Z]{1,2}\d{4,6}$")
PLATE_SUBSTRING_RE = re.compile(r"\d{2}[A-Z]{1,2}\d{4,6}")
LOOSE_PLATE_1_LETTER_RE = re.compile(r"([0-9OILSZBQD]{2})([A-Z0-9])([0-9OILSZBQD]{4,6})")
LOOSE_PLATE_2_LETTER_RE = re.compile(r"([0-9OILSZBQD]{2})([A-Z0-9]{2})([0-9OILSZBQD]{4,6})")
